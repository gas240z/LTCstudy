import time
from urllib import response
from fastapi import FastAPI, HTTPException, Request
from pydantic import BaseModel, Field
from fastapi import APIRouter, FastAPI, HTTPException


app = FastAPI(title="Qeydler API - si ")

@app.middleware("http")
async def log_requests(request: Request, call_next):
    start = time.time()
    response = await call_next(request)
    duration = round((time.time()-start)*1000,2)
    print(f'{request.method} {request.url.path} - {duration}ms')
    return response


class Note(BaseModel):
    title : str = Field(...,min_length=1)
    content : str = Field(...,min_length=5)


baza = []
router = APIRouter(prefix="/api", tags=["Notes"])


@app.get("/health")
def health():
    return {"status" : "Her sey okaydir! "}

@app.post("/notes")
def create_note(request: Note):
    baza.append(request)
    return request

@app.get("/notes")
def get_note():
    return baza

@app.get("/notes/{index}")
def get_note(index: int):
    if index < 0 or index >= len(baza):
        raise HTTPException(status_code=404, detail="Xeta, Melumat tapilmadi")
    
    return baza[index]


app.include_router(router)



