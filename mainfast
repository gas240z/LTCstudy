from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker,DeclarativeBase,Mapped,mapped_column
from fastapi import FastAPI,Depends
from sqlalchemy.orm import Session
from pydantic import BaseModel
from sqlalchemy import select
import redis
from fastapi import HTTPException


engine  = create_engine('sqlite:///notes.db')

SessionLocal = sessionmaker(bind=engine)

class Base(DeclarativeBase):
    pass

class Qeyd(Base):
    __tablename__ = "Qeydler"

    id : Mapped[int] = mapped_column(primary_key=True)
    text : Mapped[str] = mapped_column()

Base.metadata.create_all(engine)

app = FastAPI()

def session_al():
    session = SessionLocal()
    try:
        yield session
    finally:
        session.close()



class incomemsg(BaseModel):
    metn : str


@app.post("/qeyd")
def qeydler(giris: incomemsg,session: Session = Depends(session_al)):
    yeniqeyd = Qeyd(text=giris.metn)

    session.add(yeniqeyd)

    session.commit()
    session.refresh(yeniqeyd)
    return {"id": yeniqeyd.id, "text": yeniqeyd.text}


@app.get("/qeydler")
def getqeyd(session: Session = Depends(session_al)):
    s1 = select(Qeyd)
    res = session.execute(s1)
    qeydler = res.scalars().all()

    return [
        {"id": m.id, "sual": m.text}
        for m in qeydler
    ]


r = redis.Redis(host="localhost", port=6379, decode_responses=True)
@app.get("/qeyd/{qeyd_id}")
def get_qeyd_by_id(qeyd_id: int, session: Session = Depends(session_al)):
    cache_key = f"qeyd:{qeyd_id}"

    keshde_var = r.get(cache_key)

    if keshde_var:
        return {"id": qeyd_id, "text": keshde_var, "menbe": "kesh"}

    # 2. Если в кэше нет — ищем в базе SQLite
    qeyd = session.get(Qeyd, qeyd_id)

    if not qeyd:
        raise HTTPException(status_code=404, detail="Qeyd tapilmadi")

    r.set(cache_key, qeyd.text, ex=3600)

    return {"id": qeyd.id, "text": qeyd.text, "menbe": "verilenler_bazasi"}






